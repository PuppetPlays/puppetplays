# Install as /etc/cron.d/puppetplays-db-backup (root:root, 0644).
# The file name must not contain a dot, or cron ignores it.
# The script is installed as /usr/local/sbin/puppetplays-db-backup.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 3 * * *   root  /usr/local/sbin/puppetplays-db-backup daily   >> /var/log/puppetplays-db-backup.log 2>&1
30 3 * * 0  root  /usr/local/sbin/puppetplays-db-backup weekly  >> /var/log/puppetplays-db-backup.log 2>&1
0 4 1 * *   root  /usr/local/sbin/puppetplays-db-backup monthly >> /var/log/puppetplays-db-backup.log 2>&1
